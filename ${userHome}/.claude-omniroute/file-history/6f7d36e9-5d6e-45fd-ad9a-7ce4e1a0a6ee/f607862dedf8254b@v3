# Local deployment values for cue-services Helm chart
# For deployment on a local k3s/minikube cluster

# Enable infrastructure dependency (set to true to deploy infrastructure alongside)
infrastructure:
  enabled: false

# Global image settings
global:
  imageRegistry: ""
  imagePullPolicy: IfNotPresent

# Backend services configuration
backend:
  replicaCount: 1
  imageTag: latest
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

# Frontend configuration
frontend:
  imageTag: latest
  replicaCount: 1
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

# Jaeger configuration (distributed tracing)
jaeger:
  imageTag: "1.47"
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 250m
    requests:
      memory: 256Mi
      cpu: 100m

# Secrets configuration - Plain text values (will be base64 encoded by Helm chart)
secret:
  # Stripe API key for payments (use test key for local)
  STRIPE_SECRET_KEY: sk_test_421ffVAem5k5Ea8 # placeholder

  # JWT signing key for authentication tokens
  JWT_SIGNING_KEY: supersecretjwtskieforlocalhev

  # Auth Service specific secrets
  JWT_ACCESS_TOKEN_MINUTES: "15" # Access token expiry in minutes
  JWT_REFRESH_TOKEN_DAYS: "7" # Refresh token expiry in days

  # Database connection strings (pointing to infrastructure services)
  AUTH_DB_CONNECTION: Host=cue-infra-cue-infrastructure-postgres;Port=5432;Database=cue_db;Username=admin;Password=localsecret
  USER_DB_CONNECTION: Host=cue-infra-cue-infrastructure-postgres;Port=5432;Database=cue_db;Username=admin;Password=localsecret
  BOOKING_DB_CONNECTION: Host=cue-infra-cue-infrastructure-postgres;Port=5432;Database=cue_db;Username=admin;Password=localsecret
  PAYMENT_DB_CONNECTION: Host=cue-infra-cue-infrastructure-postgres;Port=5432;Database=cue_db;Username=admin;Password=localsecret
  ConnectionStrings__CueDatabase: Host=cue-infra-cue-infrastructure-postgres;Port=5432;Database=cue_db;Username=admin;Password=localsecret

  # Email service credentials
  EMAIL_API_KEY: local # placeholder
  EMAIL_FROM_ADDRESS: cue@localhost.local

  # Redis connection strings (point to infrastructure Redis)
  REDIS_CONNECTION_STRING: redis://cue-infra-cue-infrastructure-redis:6379

  # RabbitMQ connection (point to infrastructure RabbitMQ)
  RABBITMQ_CONNECTION_STRING: amqp://admin:localsecret@cue-infra-cue-infrastructure-rabbitmq:5672

  # Jaeger tracing endpoint
  JAEGER_AGENT_HOST: jaeger-agent-split-jeager:6831

# Ingress configuration for local development
ingress:
  enabled: true
  className: nginx
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
  hosts:
    - host: cue.local
      paths:
        - path: /
          pathType: Prefix
        - path: /api
          pathType: Prefix
  tls: []

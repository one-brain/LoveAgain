apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "infrastructure.fullname" . }}-pg-admin
  labels:
    {{- include "infrastructure.labels" . | nindent 4 }}
    app.kubernetes.io/name: pg-admin
    app.kubernetes.io/component: database-admin
spec:
  replicas: {{ .Values.pgAdmin.replicaCount }}
  selector:
    matchLabels:
      {{- include "infrastructure.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/name: pg-admin
  template:
    metadata:
      labels:
        {{- include "infrastructure.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/name: pg-admin
    spec:
      containers:
        - name: pg-admin
          image: dpage/pgadmin4:{{ .Values.pgAdmin.imageTag }}
          ports:
            - containerPort: 80
          env:
            - name: PGADMIN_DEFAULT_EMAIL
              value: "{{ .Values.pgAdmin.defaultEmail }}"
            - name: PGADMIN_DEFAULT_PASSWORD
              value: "{{ .Values.pgAdmin.defaultPassword }}"
            - name: PGADMIN_CONFIG_SERVER_MODE
              value: "False"
          resources:
            {{- toYaml .Values.pgAdmin.resources | nindent 12 }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ include "infrastructure.fullname" . }}-pg-admin
  labels:
    {{- include "infrastructure.labels" . | nindent 4 }}
    app.kubernetes.io/name: pg-admin
spec:
  type: NodePort
  selector:
    {{- include "infrastructure.selectorLabels" . | nindent 4 }}
    app.kubernetes.io/name: pg-admin
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30001
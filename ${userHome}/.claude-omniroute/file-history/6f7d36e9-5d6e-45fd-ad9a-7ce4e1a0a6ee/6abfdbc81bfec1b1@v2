apiVersion: v1
kind: Secret
metadata:
  name: {{ include "infrastructure.fullname" . }}-secrets
  labels:
    {{- include "infrastructure.labels" . | nindent 4 }}
type: Opaque
stringData:
  # PostgreSQL credentials
  POSTGRES_USER: {{ .Values.secret.POSTGRES_USER }}
  POSTGRES_PASSWORD: {{ .Values.secret.POSTGRES_PASSWORD }}
  POSTGRES_DB: {{ .Values.secret.POSTGRES_DB }}

  # RabbitMQ credentials
  RABBITMQ_USER: {{ .Values.secret.RABBITMQ_USER }}
  RABBITMQ_PASSWORD: {{ .Values.secret.RABBITMQ_PASSWORD }}

  # Redis password
  REDIS_PASSWORD: {{ .Values.secret.REDIS_PASSWORD }}
{{- range .Values.backendServices }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .name }}
  namespace: {{ $.Release.Namespace }}
  labels:
    {{- include "services.labels" $ | nindent 4 }}
    app.kubernetes.io/component: backend
spec:
  type: ClusterIP
  ports:
    - port: {{ .port }}
      targetPort: {{ .port }}
      protocol: TCP
  selector:
    {{- include "services.selectorLabels" $ | nindent 4 }}
    app.kubernetes.io/name: {{ .name }}
{{- end }}
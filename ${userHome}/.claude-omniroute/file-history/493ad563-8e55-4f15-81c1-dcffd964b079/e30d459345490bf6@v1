{{- /*
   This partial expects the context to be a dictionary with:
   - name: service name
   - port: container port
   - replicaCount: (optional) overrides .Values.backend.replicaCount
   - imageTag: (optional) overrides .Values.backend.imageTag
   - resources: (optional) overrides .Values.backend.resources
*/ -}}
{{- $serviceName := .name }}
{{- $servicePort := .port }}
{{- $replicaCount := default (.Values.backend.replicaCount) .replicaCount }}
{{- $imageTag := default (.Values.backend.imageTag) .imageTag }}
{{- $resources := default (.Values.backend.resources) .resources }}

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ printf "%s-%s" .Release.Name $serviceName | trunc 63 | trimSuffix "-" }}
  labels:
    {{- include "cue.labels" . | nindent 4 }}
spec:
  replicas: {{ $replicaCount }}
  selector:
    matchLabels:
      {{- include "cue.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/name: {{ $serviceName }}
  template:
    metadata:
      labels:
        {{- include "cue.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/name: {{ $serviceName }}
    spec:
      containers:
        - name: {{ $serviceName }}
          image: "{{ .Values.global.imageRegistry }}{{ if .Values.global.imageRegistry }}/{{ end }}{{ $serviceName }}:{{ $imageTag }}"
          ports:
            - containerPort: {{ $servicePort }}
          envFrom:
            - configMapRef:
                name: {{ include "cue.fullname" . }}-backend-config
            - secretRef:
                name: {{ include "cue.fullname" . }}-backend-secret
          resources:
            {{- toYaml $resources | nindent 12 }}
          livenessProbe:
            httpGet:
              path: /health
              port: {{ $servicePort }}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ $servicePort }}
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: {{ printf "%s-%s" .Release.Name $serviceName | trunc 63 | trimSuffix "-" }}
  labels:
    {{- include "cue.labels" . | nindent 4 }}
spec:
  selector:
    {{- include "cue.selectorLabels" . | nindent 6 }}
    app.kubernetes.io/name: {{ $serviceName }}
  ports:
    - protocol: TCP
      port: {{ $servicePort }}
      targetPort: {{ $servicePort }}
  type: {{ .Values.service.type | default "ClusterIP" }}
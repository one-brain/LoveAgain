using Cue.Domain;

namespace Cue.Domain.Tests;

public sealed class UserTests
{
    [Fact]
    public void User_NormalizesEmailAndClampsTrustScore()
    {
        var user = new User(" PERSON@Example.COM ", "Ada", "Lovelace", UserRole.Provider);

        user.ApplyTrustDelta(100);

        Assert.Equal("person@example.com", user.Email);
        Assert.Equal(100, user.TrustScore);
        Assert.Contains(UserRole.Provider, user.Roles);
    }
}

{{- $serviceName := .Values.name }}
{{- $servicePort := .Values.port }}
{{- $replicaCount := .Values.replicaCount | default (.Values.backend.replicaCount) }}
{{- $imageTag := .Values.imageTag | default (.Values.backend.imageTag) }}
{{- $resources := .Values.resources | default (.Values.backend.resources) }}

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ printf "%s-%s" .Release.Name $serviceName | trunc 63 | trimSuffix "-" }}
  labels:
    {{- include "cue.labels" . | nindent 4 }}
spec:
  replicas: {{ $replicaCount }}
  selector:
    matchLabels:
      {{- include "cue.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/name: {{ $serviceName }}
  template:
    metadata:
      labels:
        {{- include "cue.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/name: {{ $serviceName }}
    spec:
      containers:
        - name: {{ $serviceName }}
          image: "{{ .Values.global.imageRegistry }}{{ if .Values.global.imageRegistry }}/{{ end }}{{ $serviceName }}:{{ $imageTag }}"
          ports:
            - containerPort: {{ $servicePort }}
          envFrom:
            - configMapRef:
                name: {{ include "cue.fullname" . }}-backend-config
            - secretRef:
                name: {{ include "cue.fullname" . }}-backend-secret
          resources:
            {{- toYaml $resources | nindent 12 }}
          livenessProbe:
            httpGet:
              path: /health
              port: {{ $servicePort }}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ $servicePort }}
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: {{ printf "%s-%s" .Release.Name $serviceName | trunc 63 | trimSuffix "-" }}
  labels:
    {{- include "cue.labels" . | nindent 4 }}
spec:
  selector:
    {{- include "cue.selectorLabels" . | nindent 6 }}
    app.kubernetes.io/name: {{ $serviceName }}
  ports:
    - protocol: TCP
      port: {{ $servicePort }}
      targetPort: {{ $servicePort }}
  type: {{ .Values.service.type | default "ClusterIP" }}
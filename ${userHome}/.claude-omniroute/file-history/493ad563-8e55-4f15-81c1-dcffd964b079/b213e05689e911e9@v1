using AuthService;
using Cue.Domain;
using Cue.Infrastructure.Data;
using Cue.Infrastructure.Email;
using Microsoft.Extensions.Options;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using System.Security.Claims;
using System.Security.Cryptography;
using System.Text;



namespace AuthService.Controllers;

[ApiController]
[Route("api/v1/auth")]
public sealed class AuthController(
    CueDbContext dbContext,
    PasswordService passwords,
    JwtTokenService tokens,
    IEmailSender emailSender,
    IOptions<AppOptions> appOptions) : ControllerBase
{
    private const string RefreshTokenCookie = "cue.refresh";

    [HttpPost("register")]
    public async Task<ActionResult<TokenResponse>> Register(RegisterRequest request, CancellationToken cancellationToken)
    {
        // The unique index spans deleted accounts too, so any existing row blocks
        // reuse until anonymization/purge lands.
        if (await dbContext.Users.AnyAsync(user => user.Email == request.Email.Trim().ToLower(), cancellationToken))
        {
            return Conflict(new { error = "An account with this email already exists." });
        }

        if (!Enum.TryParse<UserRole>(request.Role, true, out var role))
        {
            return BadRequest(new { error = "Role must be Seeker, Provider, or Admin." });
        }

        var user = new User(request.Email, request.FirstName, request.LastName, role);
        user.SetPasswordHash(passwords.Hash(request.Password));
        dbContext.Users.Add(user);

        var tokenResponse = await IssueTokensAsync(user, cancellationToken);
        await dbContext.SaveChangesAsync(cancellationToken);

        // Fire after save so the user row exists; verification never blocks registration.
        try
        {
            await SendVerificationEmailAsync(user, cancellationToken);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Verification email failed for {user.Email}: {ex.Message}");
        }

        return StatusCode(StatusCodes.Status201Created, tokenResponse);
    }

    [HttpPost("login")]
    public async Task<ActionResult<TokenResponse>> Login(LoginRequest request, CancellationToken cancellationToken)
    {
        var user = await dbContext.Users.SingleOrDefaultAsync(candidate => candidate.Email == request.Email.Trim().ToLower(), cancellationToken);
        if (user?.PasswordHash is null || user.IsDeleted || !passwords.Verify(request.Password, user.PasswordHash))
        {
            return Unauthorized(new { error = "Invalid email or password." });
        }

        var tokenResponse = await IssueTokensAsync(user, cancellationToken);
        await dbContext.SaveChangesAsync(cancellationToken);

        return Ok(tokenResponse);
    }

    [HttpPost("refresh")]
    public async Task<ActionResult<TokenResponse>> Refresh(CancellationToken cancellationToken)
    {
        var raw = Request.Cookies[RefreshTokenCookie];
        if (string.IsNullOrEmpty(raw))
            return Unauthorized(new { error = "Refresh token is missing." });

        var hash = HashToken(raw);
        var stored = await dbContext.RefreshTokens
            .SingleOrDefaultAsync(t => t.TokenHash == hash, cancellationToken);

        if (stored is null || !stored.IsActive)
        {
            Response.Cookies.Delete(RefreshTokenCookie);
            return Unauthorized(new { error = "Refresh token is invalid or expired." });
        }

        var user = await dbContext.Users.FindAsync([stored.UserId], cancellationToken);
        if (user is null)
        {
            Response.Cookies.Delete(RefreshTokenCookie);
            return Unauthorized(new { error = "Refresh token is invalid or expired." });
        }

        stored.Revoke();

        var tokenResponse = await IssueTokensAsync(user, cancellationToken);
        await dbContext.SaveChangesAsync(cancellationToken);

        return Ok(tokenResponse);
    }

    [HttpPost("logout")]
    public async Task<IActionResult> Logout(CancellationToken cancellationToken)
    {
        var raw = Request.Cookies[RefreshTokenCookie];
        if (!string.IsNullOrEmpty(raw))
        {
            var hash = HashToken(raw);
            var stored = await dbContext.RefreshTokens
                .SingleOrDefaultAsync(t => t.TokenHash == hash, cancellationToken);
            if (stored?.IsActive == true)
            {
                stored.Revoke();
                await dbContext.SaveChangesAsync(cancellationToken);
            }
        }

        Response.Cookies.Delete(RefreshTokenCookie, new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Strict,
            Path = "/api/v1/auth",
        });

        return NoContent();
    }

    [HttpPost("forgot-password")]
    public async Task<IActionResult> ForgotPassword(ForgotPasswordRequest request, CancellationToken cancellationToken)
    {
        var user = await dbContext.Users.SingleOrDefaultAsync(
            candidate => candidate.Email == request.Email.Trim().ToLower(), cancellationToken);

        // Always return 204 so attackers cannot enumerate registered emails.
        // Deleted accounts get no reset email either.
        if (user is null || user.IsDeleted) return NoContent();

        // Invalidate any outstanding reset tokens for this account.
        var existing = await dbContext.PasswordResetTokens
            .Where(t => t.UserId == user.Id && t.UsedAt == null)
            .ToListAsync(cancellationToken);
        foreach (var token in existing) token.MarkUsed();

        var (raw, hash) = tokens.GenerateRefreshToken();
        dbContext.PasswordResetTokens.Add(new PasswordResetToken(user.Id, hash, DateTime.UtcNow.AddHours(1)));
        await dbContext.SaveChangesAsync(cancellationToken);

        await SendPasswordResetEmailAsync(user.Email, raw, cancellationToken);
        return NoContent();
    }

    private async Task SendPasswordResetEmailAsync(string email, string rawToken, CancellationToken cancellationToken)
    {
        var resetUrl = $"{appOptions.Value.FrontendBaseUrl.TrimEnd('/')}/reset-password?token={Uri.EscapeDataString(rawToken)}";
        var sent = await emailSender.SendAsync(new EmailMessage(
            email,
            "Reset your Cue password",
            $"""
            Hi,

            We received a request to reset your Cue password. This link is valid for 1 hour:

            {resetUrl}

            If you didn't request this, you can safely ignore this email — your password is unchanged.

            — The Cue team
            """,
            $"""
            <p>Hi,</p>
            <p>We received a request to reset your Cue password. Click the link below to choose a new one. It is valid for 1 hour:</p>
            <p><a href="{resetUrl}">Reset my password</a></p>
            <p style="color:#6b7280">Or paste this link into your browser: {resetUrl}</p>
            <p>If you didn't request this, you can safely ignore this email — your password is unchanged.</p>
            <p>— The Cue team</p>
            """), cancellationToken);

        if (!sent && HttpContext.RequestServices.GetRequiredService<IHostEnvironment>().IsDevelopment())
        {
            // Provider rejected it in dev: fall back to the log so the flow stays testable.
            Console.WriteLine($"[DEV] Password reset token for {email}: {rawToken}");
        }
    }

    [HttpPost("reset-password")]
    public async Task<IActionResult> ResetPassword(ResetPasswordRequest request, CancellationToken cancellationToken)
    {
        if (request.NewPassword.Length < 8)
            return BadRequest(new { error = "Password must be at least 8 characters." });

        var hash = HashToken(request.Token);
        var stored = await dbContext.PasswordResetTokens
            .SingleOrDefaultAsync(t => t.TokenHash == hash, cancellationToken);

        if (stored is null || !stored.IsUsable)
            return BadRequest(new { error = "This reset link is invalid or has expired." });

        var user = await dbContext.Users.FindAsync([stored.UserId], cancellationToken);
        if (user is null)
            return BadRequest(new { error = "This reset link is invalid or has expired." });

        user.SetPasswordHash(passwords.Hash(request.NewPassword));
        stored.MarkUsed();

        // Kill every live session — the old password may have been compromised.
        var sessions = await dbContext.RefreshTokens
            .Where(t => t.UserId == user.Id && t.RevokedAt == null)
            .ToListAsync(cancellationToken);
        foreach (var session in sessions) session.Revoke();

        await dbContext.SaveChangesAsync(cancellationToken);
        Response.Cookies.Delete(RefreshTokenCookie);

        return NoContent();
    }

    [HttpPost("verify-email")]
    public async Task<IActionResult> VerifyEmail(VerifyEmailRequest request, CancellationToken cancellationToken)
    {
        var hash = HashToken(request.Token);
        var stored = await dbContext.EmailVerificationTokens
            .SingleOrDefaultAsync(t => t.TokenHash == hash, cancellationToken);

        if (stored is null || !stored.IsUsable)
            return BadRequest(new { error = "This verification link is invalid or has expired." });

        var user = await dbContext.Users.FindAsync([stored.UserId], cancellationToken);
        if (user is null || user.IsDeleted)
            return BadRequest(new { error = "This verification link is invalid or has expired." });

        // Already verified (e.g. a stale link): treat as success so the UI stays friendly.
        if (!user.IsVerified) user.Verify();

        stored.MarkUsed();
        await dbContext.SaveChangesAsync(cancellationToken);

        return NoContent();
    }

    [Authorize]
    [HttpPost("resend-verification")]
    public async Task<IActionResult> ResendVerification(CancellationToken cancellationToken)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null || !Guid.TryParse(userId, out var id)) return Unauthorized();

        var user = await dbContext.Users.FindAsync([id], cancellationToken);
        if (user is null || user.IsDeleted) return Unauthorized();
        if (user.IsVerified) return NoContent();

        // Invalidate any outstanding verification tokens for this account.
        var existing = await dbContext.EmailVerificationTokens
            .Where(t => t.UserId == user.Id && t.UsedAt == null)
            .ToListAsync(cancellationToken);
        foreach (var token in existing) token.MarkUsed();

        var (raw, hash) = tokens.GenerateRefreshToken();
        dbContext.EmailVerificationTokens.Add(new EmailVerificationToken(user.Id, hash, DateTime.UtcNow.AddHours(24)));
        await dbContext.SaveChangesAsync(cancellationToken);

        try
        {
            await SendVerificationEmailAsync(user, cancellationToken);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Verification email failed for {user.Email}: {ex.Message}");
        }

        return NoContent();
    }

    private async Task SendVerificationEmailAsync(User user, CancellationToken cancellationToken)
    {
        var (raw, hash) = tokens.GenerateRefreshToken();
        dbContext.EmailVerificationTokens.Add(new EmailVerificationToken(user.Id, hash, DateTime.UtcNow.AddHours(24)));

        var verifyUrl = $"{appOptions.Value.FrontendBaseUrl.TrimEnd('/')}/verify-email?token={Uri.EscapeDataString(raw)}";
        var sent = await emailSender.SendAsync(new EmailMessage(
            user.Email,
            "Verify your Cue email",
            $"""
            Hi {user.FirstName},

            Welcome to Cue! Confirm your email address by clicking the link below. It is valid for 24 hours:

            {verifyUrl}

            If you didn't create this account, you can safely ignore this email.

            — The Cue team
            """,
            $"""
            <p>Hi {user.FirstName},</p>
            <p>Welcome to Cue! Confirm your email address by clicking the link below. It is valid for 24 hours:</p>
            <p><a href="{verifyUrl}">Verify my email</a></p>
            <p style="color:#6b7280">Or paste this link into your browser: {verifyUrl}</p>
            <p>If you didn't create this account, you can safely ignore this email.</p>
            <p>— The Cue team</p>
            """), cancellationToken);

        if (!sent && HttpContext.RequestServices.GetRequiredService<IHostEnvironment>().IsDevelopment())
        {
            Console.WriteLine($"[DEV] Email verification token for {user.Email}: {raw}");
        }
    }

    private async Task<TokenResponse> IssueTokensAsync(User user, CancellationToken cancellationToken)    {
        var (raw, hash) = tokens.GenerateRefreshToken();
        var expiresAt = DateTime.UtcNow.Add(tokens.RefreshTokenLifetime);

        dbContext.RefreshTokens.Add(new RefreshToken(user.Id, hash, expiresAt));

        SetRefreshCookie(raw, expiresAt);

        return tokens.CreateAccessToken(user);
    }

    private void SetRefreshCookie(string raw, DateTime expiresAt)
    {
        Response.Cookies.Append(RefreshTokenCookie, raw, new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Strict,
            Expires = expiresAt,
            Path = "/api/v1/auth",
        });
    }

    private static string HashToken(string raw) =>
        Convert.ToBase64String(SHA256.HashData(Encoding.UTF8.GetBytes(raw)));
}

namespace Cue.Domain;

public sealed class User
{
    private readonly HashSet<UserRole> roles = [];

    private User()
    {
    }

    public User(string email, string firstName, string lastName, UserRole role)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            throw new ArgumentException("Email is required.", nameof(email));
        }

        if (string.IsNullOrWhiteSpace(firstName))
        {
            throw new ArgumentException("First name is required.", nameof(firstName));
        }

        if (string.IsNullOrWhiteSpace(lastName))
        {
            throw new ArgumentException("Last name is required.", nameof(lastName));
        }

        Id = Guid.NewGuid();
        Email = email.Trim().ToLowerInvariant();
        FirstName = firstName.Trim();
        LastName = lastName.Trim();
        TrustScore = 50;
        CreatedAt = DateTime.UtcNow;
        UpdatedAt = CreatedAt;
        roles.Add(role);
    }

    public Guid Id { get; private set; }
    public string Email { get; private set; } = string.Empty;
    public string? PasswordHash { get; private set; }
    public string? Phone { get; private set; }
    public string FirstName { get; private set; } = string.Empty;
    public string LastName { get; private set; } = string.Empty;
    public DateOnly? DateOfBirth { get; private set; }
    public string? PhotoUrl { get; private set; }
    public bool IsVerified { get; private set; }
    public int TrustScore { get; private set; }
    public DateTime CreatedAt { get; private set; }
    public DateTime UpdatedAt { get; private set; }
    public DateTime? DeletedAt { get; private set; }
    public bool IsDeleted => DeletedAt is not null;
    public IReadOnlyCollection<UserRole> Roles => roles;

    /// <summary>
    /// Soft-deletes the account. Data is retained for legal/audit purposes but the
    /// user can no longer sign in.
    /// </summary>
    public void Delete()
    {
        if (IsDeleted) throw new InvalidOperationException("Account is already deleted.");
        DeletedAt = DateTime.UtcNow;
        UpdatedAt = DeletedAt.Value;
    }

    public void UpdateContact(string? phone, string firstName, string lastName)
    {
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
        {
            throw new ArgumentException("A first and last name are required.");
        }

        Phone = string.IsNullOrWhiteSpace(phone) ? null : phone.Trim();
        FirstName = firstName.Trim();
        LastName = lastName.Trim();
        UpdatedAt = DateTime.UtcNow;
    }

    public void UpdateProfile(string firstName, string lastName, string? phone, DateOnly? dateOfBirth)
    {
        UpdateContact(phone, firstName, lastName);
        DateOfBirth = dateOfBirth;
        UpdatedAt = DateTime.UtcNow;
    }

    /// <summary>
    /// Replaces the profile photo. Passing null removes it.
    /// </summary>
    public void SetPhotoUrl(string? photoUrl)
    {
        PhotoUrl = string.IsNullOrWhiteSpace(photoUrl) ? null : photoUrl.Trim();
        UpdatedAt = DateTime.UtcNow;
    }

    public void Verify()
    {
        IsVerified = true;
        UpdatedAt = DateTime.UtcNow;
    }

    public void SetPasswordHash(string passwordHash)
    {
        if (string.IsNullOrWhiteSpace(passwordHash)) throw new ArgumentException("Password hash is required.", nameof(passwordHash));
        PasswordHash = passwordHash;
        UpdatedAt = DateTime.UtcNow;
    }

    public void ApplyTrustDelta(int delta)
    {
        TrustScore = Math.Clamp(TrustScore + delta, 0, 100);
        UpdatedAt = DateTime.UtcNow;
    }

    public void AddRole(UserRole role)
    {
        roles.Add(role);
        UpdatedAt = DateTime.UtcNow;
    }
}

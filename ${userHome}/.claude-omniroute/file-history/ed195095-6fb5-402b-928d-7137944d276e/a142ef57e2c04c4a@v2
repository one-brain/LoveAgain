# RabbitMQ Configuration for Cue Platform
# Based on Bitnami RabbitMQ Helm Chart v16.0.14

## @section Global parameters
## Global Docker image parameters
global:
  imageRegistry: ""
  imagePullSecrets: []
  defaultStorageClass: ""
  storageClass: ""
  security:
    allowInsecureImages: false
  compatibility:
    openshift:
      adaptSecurityContext: auto

## @section RabbitMQ Image parameters
image:
  registry: docker.io
  repository: bitnami/rabbitmq
  tag: 4.1.3-debian-12-r17
  pullPolicy: IfNotPresent
  pullSecrets: []
  debug: false

## @section RabbitMQ Configuration
## RabbitMQ cluster name
clusterName: cue-rabbitmq

## Erlang cookie secret
auth:
  existingErlangSecret: ""
  erlangCookie: ""
  username: cue
  password: ""
  existingPasswordSecret: ""

## RabbitMQ management UI
management:
  enabled: true
  plugin: rabbitmq_management
  path: /api
  loadDefinitions:
    enabled: false
    definitions: ""
  service:
    type: ClusterIP
    port: 15672
    nodePort: ""
    annotations: {}
    labels: {}
  ingress:
    enabled: false
    hostname: rabbitmq.cue.local
    path: /
    annotations: {}
    className: ""
    tls: false
    secrets: []
    extraPaths: []

## Prometheus metrics exporter
prometheus:
  enabled: true
  port: 9090
  path: /metrics
  service:
    type: ClusterIP
    port: 9090
    annotations:
      prometheus.io/scrape: "true"
      prometheus.io/port: "9090"
    labels: {}
  exporter:
    enabled: true
    image:
      registry: docker.io
      repository: bitnami/rabbitmq-exporter
      tag: 0.11.1-debian-12-r10
      pullPolicy: IfNotPresent
      pullSecrets: []
    resources: {}
    env: {}
    extraFlags: ""

## Resource limits
resources:
  limits:
    cpu: 1000m
    memory: 1Gi
  requests:
    cpu: 500m
    memory: 512Mi

## Persistence configuration
persistence:
  enabled: true
  storageClass: ""
  accessModes:
    - ReadWriteOnce
  size: 8Gi
  annotations: {}
  selector: {}
  existingClaim: ""

## Node configuration
replicaCount: 1
autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 3
  targetCPUUtilizationPercentage: 80

## Pod scheduling
nodeSelector: {}
tolerations: []
affinity:
  podAntiAffinity: soft

## Network policies
networkPolicy:
  enabled: false
  ingress:
    from: []
    ports:
      - port: 5672
      - port: 15672
      - port: 15692
      - port: 25672
      - port: 4369
      - port: 9090
  egress:
    to: []
    ports: []

## Security context
podSecurityContext:
  enabled: true
  fsGroup: 1001
  runAsUser: 1001
  runAsGroup: 1001
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault

containerSecurityContext:
  enabled: true
  runAsUser: 1001
  runAsGroup: 1001
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
  seccompProfile:
    type: RuntimeDefault

## Service configuration
service:
  type: ClusterIP
  ports:
    amqp: 5672
    dist: 25672
    http: 15672
  annotations: {}
  labels: {}
  clusterIP: ""
  loadBalancerIP: ""
  loadBalancerSourceRanges: []
  externalTrafficPolicy: Cluster

## Headless service for clustering
headlessService:
  enabled: true
  annotations: {}
  labels: {}

## Extra configuration
extraConfiguration: |-
  loopback_users.guest = false
  default_user = cue
  default_pass = CHANGE_ME
  default_vhost = /
  default_permissions.configure = .*
  default_permissions.read = .*
  default_permissions.write = .*
  log.console.level = info
  log.file.level = info

## Plugins to enable
extraPlugins: []
enabledPlugins:
  - rabbitmq_management
  - rabbitmq_prometheus
  - rabbitmq_peer_discovery_k8s
  - rabbitmq_shovel
  - rabbitmq_shovel_management

## Sysctl configuration
sysctls:
  - name: net.core.somaxconn
    value: "65535"

## Service account
serviceAccount:
  create: true
  name: ""
  annotations: {}
  automountServiceAccountToken: true

## RBAC
rbac:
  create: true
  rules: []

## Lifecycle hooks
lifecycle: {}

## Init containers
initContainers: []

## Sidecars
sidecars: []

## Volume mounts
extraVolumeMounts: []
extraVolumes: []

## Environment variables
extraEnvVars: []
extraEnvVarsCM: ""
extraEnvVarsSecret: ""

## Configmap for extra configuration
configmap:
  enabled: false
  name: ""
  data: {}

## Pod disruption budget
pdb:
  enabled: false
  minAvailable: 1
  maxUnavailable: ""

## Health checks
livenessProbe:
  enabled: true
  initialDelaySeconds: 60
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6
  successThreshold: 1

readinessProbe:
  enabled: true
  initialDelaySeconds: 20
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6
  successThreshold: 1

startupProbe:
  enabled: true
  initialDelaySeconds: 10
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 30
  successThreshold: 1

## TLS configuration
tls:
  enabled: false
  autoGenerated: false
  existingSecret: ""
  certificatesSecret: ""
  verify: verify_none
  failIfNoPeerCert: false
  depth: 5
  cacertfile: ""
  certfile: ""
  keyfile: ""

## Message queue configuration
definitions:
  enabled: false
  file: ""

## Advanced configuration
advancedConfig: ""

## Priority queues
priorityQueues:
  enabled: false
  maxPriority: 10

## Shovel configuration
shovel:
  enabled: false
  configs: {}

## Federation configuration
federation:
  enabled: false
  upstreams: {}

## Load definitions from file
loadDefinition:
  enabled: false
  existingSecret: ""

## Pod labels and annotations
podLabels: {}
podAnnotations:
  prometheus.io/scrape: "true"
  prometheus.io/port: "9090"
  prometheus.io/path: "/metrics"

## Update strategy
updateStrategy:
  type: RollingUpdate

## Revision history limit
revisionHistoryLimit: 10

## Pod management policy
podManagementPolicy: Parallel

## DNS policy
dnsPolicy: ClusterFirst

## DNS config
dnsConfig: {}

## Host aliases
hostAliases: []

## Termination grace period
terminationGracePeriodSeconds: 30

## Priority class
priorityClassName: ""

## Scheduler name
schedulerName: ""

## Topology spread constraints
topologySpreadConstraints: []

## Tests
tests:
  enabled: true
  image:
    registry: docker.io
    repository: bitnami/rabbitmq
    tag: 4.1.3-debian-12-r17
    pullPolicy: IfNotPresent
apiVersion: v1
kind: Secret
metadata:
  name: auth-service-secrets
  namespace: cue-platform # or your target namespace
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: secret
  POSTGRES_DB: postgres
  RABBITMQ_USER: admin
  RABBITMQ_PASSWORD: rabbitmq-secret
  REDIS_PASSWORD: redis-secret
  STRIPE_SECRET_KEY: sk_test_...
  JWT_SIGNING_KEY: $(openssl rand -base64 32) # at least 32 chars
  JWT_ACCESS_TOKEN_MINUTES: "15"
  JWT_REFRESH_TOKEN_DAYS: "7"
  AUTH_DB_CONNECTION: host=loveagain-cue-postgres-service;database=cue_db;username=postgres;password=secret
  USER_DB_CONNECTION: host=loveagain-cue-postgres-service;database=cue_db;username=postgres;password=secret
  BOOKING_DB_CONNECTION: host=loveagain-cue-postgres-service;database=cues_db;username=postgres;password=secret
  PAYMENT_DB_CONNECTION: host=loveagain-cue-postgres-service;database=cues_db;username=postgres;password=secret
  EMAIL_API_KEY: your-email-api-key
  EMAIL_FROM_ADDRESS: cue@mailcompany.com
  REDIS_CONNECTION_STRING: redis://redis:6379

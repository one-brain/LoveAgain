apiVersion: v1
kind: Secret
metadata:
  name: auth-service-secrets
  namespace: cue-platform # or your target namespace
type: Opaque
stringData:
  POSTGRES_USER: admin
  POSTGRES_PASSWORD: secret@123
  POSTGRES_DB: cue_db
  RABBITMQ_USER: admin
  RABBITMQ_PASSWORD: rabbitmq-secret
  REDIS_PASSWORD: redis-secret
  STRIPE_SECRET_KEY: sk_test_...
  JWT_SIGNING_KEY: $(openssl rand -base64 32) # at least 32 chars
  JWT_ACCESS_TOKEN_MINUTES: "15"
  JWT_REFRESH_TOKEN_DAYS: "7"
  AUTH_DB_CONNECTION: host=postgres;database=cue_db;username=admin;password=secret@123
  USER_DB_CONNECTION: host=postgres;database=cue_db;username=admin;password=secret@123
  BOOKING_DB_CONNECTION: host=postgres;database=cue_db;username=admin;password=secret@123
  PAYMENT_DB_CONNECTION: host=postgres;database=cue_db;username=admin;password=secret@123
  EMAIL_API_KEY: your-email-api-key
  EMAIL_FROM_ADDRESS: cue@mailcompany.com
  REDIS_CONNECTION_STRING: redis://redis:6379

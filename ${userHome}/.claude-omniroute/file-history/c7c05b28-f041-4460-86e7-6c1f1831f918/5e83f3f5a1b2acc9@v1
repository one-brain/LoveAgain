# Default values for cue-services.
# This chart manages microservices that are under active development and need frequent deployments.

# Enable/disable infrastructure dependency
infrastructure:
  enabled: false

# Global image settings for all services
global:
  imageRegistry: ""
  imagePullPolicy: IfNotPresent

# Backend services common configuration
backend:
  replicaCount: 1
  imageTag: latest
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m
  env: {}

# List of backend services
backendServices:
  - name: auth-service
    port: 8080
  - name: user-service
    port: 8080
  - name: profile-service
    port: 8080
  - name: discovery-service
    port: 8080
  - name: booking-service
    port: 8080
  - name: payment-service
    port: 8080
  - name: chat-service
    port: 8080
  - name: notification-service
    port: 8080
  - name: review-service
    port: 8080
  - name: support-service
    port: 8080
  - name: analytics-service
    port: 8080
  - name: api-gateway
    port: 8080

# Frontend configuration
frontend:
  imageTag: latest
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m

# Jaeger configuration (distributed tracing)
jaeger:
  imageTag: "1.47"
  replicaCount: 1
  resources:
    limits:
      memory: 1Gi
      cpu: 500m
    requests:
      memory: 512Mi
      cpu: 250m


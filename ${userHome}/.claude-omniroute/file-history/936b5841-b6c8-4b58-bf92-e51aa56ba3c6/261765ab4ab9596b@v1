# Local deployment values for cue-platform Helm chart
# For deployment on a local k3s/minikube cluster

# Image registry and pull policy
image:
  registry: docker.io/library
  pullPolicy: Never  # Use local docker images, don't pull from registry
  tag: "latest"

# Global image settings
global:
  imageRegistry: 172.17.0.1:5000
  imagePullPolicy: IfNotPresent

# Backend services configuration
backend:
  replicaCount: 1
  imageTag: latest
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

# Frontend configuration
frontend:
  imageTag: latest
  replicaCount: 1
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

# PostgreSQL configuration
postgres:
  imageTag: "15-3.4"
  replicaCount: 1
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m
  persistence:
    enabled: true
    accessMode: ReadWriteOnce
    size: 5Gi

# RabbitMQ configuration
rabbitmq:
  imageTag: "3-management"
  replicaCount: 1
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

# Redis configuration
redis:
  imageTag: "7-alpine"
  replicaCount: 1
  resources:
    limits:
      memory: 128Mi
      cpu: 100m
    requests:
      memory: 64Mi
      cpu: 50m

# Jaeger configuration (distributed tracing)
jaeger:
  imageTag: "1.47"
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 250m
    requests:
      memory: 256Mi
      cpu: 100m


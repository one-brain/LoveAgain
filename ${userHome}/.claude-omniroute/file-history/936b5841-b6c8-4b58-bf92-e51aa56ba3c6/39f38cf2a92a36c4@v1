# Default values for cue.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

replicaCount: 1

sealedSecrets:
  enabled: false

image:
  registry: docker.io
  repository: cue
  pullPolicy: IfNotPresent
  # Overrides the image tag whose default is the chart appVersion.
  tag: "latest"

# Global image settings for all services
global:
  imageRegistry: ""
  imagePullPolicy: IfNotPresent

# Backend services common configuration
backend:
  replicaCount: 1
  imageTag: latest
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m
  env: {}

# List of backend services
backendServices:
  - name: auth-service
    port: 8080
  - name: user-service
    port: 8080
  - name: profile-service
    port: 8080
  - name: discovery-service
    port: 8080
  - name: booking-service
    port: 8080
  - name: payment-service
    port: 8080
  - name: chat-service
    port: 8080
  - name: notification-service
    port: 8080
  - name: review-service
    port: 8080
  - name: support-service
    port: 8080
  - name: analytics-service
    port: 8080
  - name: api-gateway
    port: 8080

# Frontend configuration
frontend:
  imageTag: latest
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m

# Infrastructure services
postgres:
  imageTag: "15.19"
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m
  persistence:
    enabled: true
    # existingVolumeName:
    accessMode: ReadWriteOnce
    size: 10Gi

rabbitmq:
  imageTag: "3-management"
  replicaCount: 1
  resources:
    limits:
      memory: 512Mi
      cpu: 500m
    requests:
      memory: 256Mi
      cpu: 250m

redis:
  imageTag: "7-alpine"
  replicaCount: 1
  resources:
    limits:
      memory: 256Mi
      cpu: 250m
    requests:
      memory: 128Mi
      cpu: 100m

jaeger:
  imageTag: "1.47"
  replicaCount: 1
  resources:
    limits:
      memory: 1Gi
      cpu: 500m
    requests:
      memory: 512Mi
      cpu: 250m

# Secret values (to be set by the user, preferably via --set-file or --set-string)
# RAW secrets (no base64 required)
# Example: echo -n "your-value" | base64
secret:
  # PostgreSQL credentials
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: secret
  POSTGRES_DB: cue_db

  # RabbitMQ credentials
  RABBITMQ_USER: admin
  RABBITMQ_PASSWORD: secret

  # Redis password
  REDIS_PASSWORD: secret

  # Stripe API key for payments
  STRIPE_SECRET_KEY: sk_test_421ffVAem5k5Ea8  # placeholder

  # JWT signing key for authentication tokens
  JWT_SIGNING_KEY: supersecretjwtskieforlocal  # placeholder

  # Auth Service specific secrets
  JWT_ACCESS_TOKEN_MINUTES: "15"
  JWT_REFRESH_TOKEN_DAYS: "7"

  # Database connection strings
  AUTH_DB_CONNECTION: Host=loveagain-cue-postgres-service;Port=5432;Database=cue;Username=postgres;Password=secret
  # Auth Service DB connection string
  USER_DB_CONNECTION: Host=loveagain-cue-postgres-service;Port=5432;Database=cue;Username=postgres;Password=secret
  # User Service DB connection string
  BOOKING_DB_CONNECTION: Host=loveagain-cue-postgres-service;Port=5432;Database=cues;Username=adm;Password=secret
  # Booking Service DB connection string
  PAYMENT_DB_CONNECTION: Host=loveagain-cue-postgres-service;Port=5432;Database=cues;Username=adm;Password=secret
  # Payment Service DB connection string

  # Email service credentials (if using external email provider)
  EMAIL_API_KEY: c2vjcmV0  # placeholder
  EMAIL_FROM_ADDRESS: cue@mailcompany.com

  ConnectionStrings__CueDatabase: Host=loveagain-cue-postgres-service;Port=5432;Database=cue;Username=postgres;Password=secret
  # Redis connection strings
  REDIS_CONNECTION_STRING: redis://redis:6379

# Example of how to generate base64 values:
# Linux/macOS:  echo -n "your-value" | base64
# Windows PS:   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-value"))

# Ingress configuration
ingress:
  enabled: true
  className: ""
  annotations: {}
    # kubernetes.io/ingress.class: nginx
    # kubernetes.io/tls-acme: "true"
  hosts:
    - host: chart-example.local
      paths:
        - path: /
          pathType: ImplementationSpecific
        - path: /api
          pathType: ImplementationSpecific
  tls: []
  #  - secretName: chart-example-tls
  #    hosts:
  #      - chart-example.local

# Service configuration for all services (if needed)
service:
  type: ClusterIP
  port: 80

# Resource limits and requests can be overridden per service above, but we provide a default here.
resources: {}
  # We usually recommend not to specify default resources and to leave this as a conscious
  # choice for the user. This also increases chances charts run on environments with little
  # resources, such as Minikube. If you do want to specify resources, uncomment the following
  # lines, adjust them as necessary, and remove the curly braces after 'resources:'.
  # limits:
  #   cpu: 100m
  #   memory: 128Mi
  # requests:
  #   cpu: 100m
  #   memory: 128Mi

# Node labels for pod assignment.
# Ref: https://kubernetes.io/docs/user-guide/node-selection/
nodeSelector: {}

# Tolerations for pod assignment.
# Ref: https://kubernetes.io/docs/concepts/configuration/taint-and-toleration/
tolerations: []

# Affinity for pod assignment.
# Ref: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/
affinity: {}

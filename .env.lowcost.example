# ==============================================================================
# Cue Low-Cost Deployment Environment Variables
# Copy this file to .env.lowcost before launching:
# cp .env.lowcost.example .env.lowcost
# ==============================================================================

ENVIRONMENT=Production

# Database Credentials
POSTGRES_USER=cue_admin
POSTGRES_PASSWORD=generate_a_secure_password_here_123!
POSTGRES_DB=cue_db

# Message Broker Credentials
RABBITMQ_USER=cue_admin
RABBITMQ_PASSWORD=generate_a_secure_rabbitmq_password_123!

# Cache Credentials
REDIS_PASSWORD=generate_a_secure_redis_password_123!

# Authentication Secret (Minimum 32 characters)
JWT_SIGNING_KEY=your_secure_32_char_minimum_jwt_secret_key_here!

# Third-party Integrations (Optional for sandbox/mock testing)
STRIPE_SECRET_KEY=sk_test_placeholder
EMAIL_API_KEY=placeholder
EMAIL_FROM_ADDRESS=support@yourdomain.com

<Project>
  <!-- Global low-cost runtime & compiler optimizations for all Cue .NET projects -->
  <PropertyGroup>
    <!-- Switch from Server GC to Workstation GC: cuts container idle RAM from ~250MB to ~40-60MB per service -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Dynamic Adaptation To Application Sizes (.NET 8/9/10): dynamically scales down heaps in container cgroups -->
    <GCDynamicAdaptationMode>1</GCDynamicAdaptationMode>
    <!-- Tiered PGO for optimized memory throughput and JIT warmup -->
    <TieredPGO>true</TieredPGO>
    
    <!-- Strip symbols and debug metadata in Release build to minimize container binary sizes -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml
*.swp
*.swo

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
.nuget/packages/
.nuget/NuGet.Config
.nuget/NuGet.exe

# Local History
.localhistory/

# Entity Framework files
*.edmx.sql
*.edmx.designer.cs

# Node.js
node_modules/
npm-debug.log
package-lock.json
yarn.lock

# Flutter
build/
android/.gradle
android/local.properties
android/app/debug
android/app/profile
android/app/release

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Docker
*.log
.dockerignore

# Kubernetes
*.yaml.bak
*.yml.bak

# Temporary files
*.tmp
*.temp
*.swp
*~

# Test coverage
coverage/
htmlcov/

# IDE
*.code-workspace
.claude/settings.local.json
